# =============================================================================
# LLM（ask / check-llm / eval）
# =============================================================================

# OpenAI 兼容 API base，例如 DeepSeek、OpenAI、其他兼容服务
BASE_URL=https://api.deepseek.com

# 勿提交真实 key；复制本文件为 .env 后填写
# API_KEY=your_real_api_key

# Chat 模型 id，须与 BASE_URL 侧一致
MODEL_NAME=deepseek-flash

# =============================================================================
# wiki-graph（可选）
# =============================================================================

# 语料目录，默认 fixtures/corpus
# WIKI_GRAPH_CORPUS_DIR=fixtures/corpus

# 索引路径，默认 var/indexes/wiki-graph-v1/raw-wiki
# WIKI_GRAPH_INDEX_ROOT=var/indexes
# WIKI_GRAPH_INDEX_PROFILE=wiki-graph-v1
# WIKI_GRAPH_INDEX_VARIANT=raw-wiki
# 未设置时也可读 RAG_INDEX_VARIANT
# WIKI_GRAPH_INDEX_DIR=var/indexes/wiki-graph-v1/raw-wiki

# Embedding：local（默认）| fake | openai
# WIKI_GRAPH_EMBEDDING=local
# WIKI_GRAPH_EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# WIKI_GRAPH_EMBEDDING_DEVICE=cpu
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your_embedding_api_key

# Agent 单次对话内 RAG 工具调用上限，默认 4
# RAG_BUDGET=4