# =============================================================================
# LLM（与 wiki-agent 对齐的三项；wiki-graph M0–M2 至少需要这些）
# =============================================================================

# OpenAI 兼容 API base，例如 DeepSeek、OpenAI、其他兼容服务
BASE_URL=https://api.deepseek.com

# 勿提交真实 key；复制本文件为 .env 后填写
# API_KEY=your_real_api_key

# Chat 模型 id，须与 BASE_URL 侧一致
MODEL_NAME=deepseek-flash

# =============================================================================
# wiki-graph 专用（可选）
# =============================================================================

# 语料目录，默认 fixtures/corpus
# WIKI_GRAPH_CORPUS_DIR=fixtures/corpus

# 本地检索索引输出目录，默认 .wiki_graph_index
# WIKI_GRAPH_INDEX_DIR=.wiki_graph_index

# 索引/Embedding：openai（默认，需 API）或 fake（pytest / 无 Embedding API）
# WIKI_GRAPH_EMBEDDING=fake

# Agent RAG 调用预算（M3+ 生效），默认 4
# RAG_BUDGET=4

# =============================================================================
# 从 wiki-agent 拷贝过来的变量
# =============================================================================
# wiki-graph 当前会加载 .env 中的全部键，但只读取上面几项与 README「环境变量」表中列出的 wiki-graph 专用项。
# TRACE_LEVEL、HARNESS、KNOWLEDGE_* 等 wiki-agent 专用变量会被忽略，保留无害。